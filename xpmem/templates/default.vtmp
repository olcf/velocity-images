@from
    {{ __base__ }}

@pre
    ?? backend=apptainer |> %setup ??
    ?? backend=apptainer |> mkdir -p ${APPTAINER_ROOTFS}/lib/modules/$(uname -r)/build ??

@run
    ?? distro=ubuntu |> apt -y install git make autoconf automake libtool libelf-dev && apt clean ??
    >>> install
    git clone https://github.com/openucx/xpmem.git
    cd xpmem
    git checkout v{{ __version__ }}
    ./autogen.sh
    ./configure
    make
    make install
    cd .. && rm -r xpmem

@env
    XPMEM_VERSION {{ __version__ }}
