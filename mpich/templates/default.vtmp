@from
    {{ __base__ }}

@copy
    ?? ^libfabric ^ucx |> netmod.sh /.singularity.d/env/99-netmod.sh ??
    ?? ^libfabric ^ucx backend=podman |> entrypoint.sh /entrypoint.sh ??

@run
    ?? distro=ubuntu |> apt -y install wget make pkg-config file python3 && apt clean ??
    ?? distro=rockylinux |> dnf -y install wget && dnf clean all ??
    ?? distro=opensuse |> zypper --non-interactive install wget gzip && zypper clean --all ??
    >>> test gcc version and add fortran flag if gcc version >= 10
    if [ ! -z "$(gcc --version | grep -Eo -m 1 [0-9][0-9]+\.[0-9]+\.[0-9]+ | grep -m 1 [0-9])" ]; then \
        export FFLAGS=-fallow-argument-mismatch; \
    fi
    >>> install
    wget --progress=bar:force https://www.mpich.org/static/downloads/{{ __version__ }}/mpich-{{ __version__ }}.tar.gz
    tar xzf mpich-{{ __version__ }}.tar.gz
    mkdir build && cd build
    ../mpich-{{ __version__ }}/configure --with-device=ch4:{{ netmods }} --prefix={{ prefix }}/mpich/{{ __version__ }} \
    {{ configure_flags }} {{ ucx_flags }} {{ libfabric_flags }} {{ rocm_flags }}
    make install -j{{ __threads__ }}
    cd /
    rm -rf build mpich-{{ __version__ }} mpich-{{ __version__ }}.tar.gz
    ?? ^libfabric ^ucx backend=podman |> chmod +x /entrypoint.sh ??

@env
    MPICH_VERSION {{ __version__ }}
    MPICH_URL https://www.mpich.org/static/downloads/{{ __version__ }}/mpich-{{ __version__ }}.tar.gz
    MPICH_DIR {{ prefix }}/mpich/{{ __version__ }}
    PATH {{ prefix }}/mpich/{{ __version__ }}/bin:$PATH
    LIBRARY_PATH {{ prefix }}/mpich/{{ __version__ }}/lib:$LIBRARY_PATH
    LD_LIBRARY_PATH {{ prefix }}/mpich/{{ __version__ }}/lib:$LD_LIBRARY_PATH

@post
    ?? ^libfabric ^ucx backend=podman |> ENTRYPOINT ["/entrypoint.sh"] ??
    ?? ^libfabric ^ucx backend=podman |> CMD ["/bin/bash"] ??